{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["consumer-types.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
