# INACTIVE template. Only the named temporary QA branch receives an active copy.
name: Temporary Traverse OpenAI acceptance
on:
  push:
    branches: [qa/traverse-openai-20261112-1]
    paths: [.github/workflows/traverse-openai-20261112.yml]
permissions:
  contents: write
  actions: write
jobs:
  focused:
    if: github.repository == 'alvarovillalbaa/traverse' && github.event.repository.private == false && github.ref == 'refs/heads/qa/traverse-openai-20261112-1'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      CI: "true"
      DO_NOT_TRACK: "1"
      OPENAI_API_KEY: ""
      ANTHROPIC_API_KEY: ""
      AI_GATEWAY_API_KEY: ""
      NODE_AUTH_TOKEN: ""
      NPM_TOKEN: ""
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: SOURCE_COMMIT
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: 24.21.0
          package-manager-cache: false
      - name: Focused package, unit, declaration and Chromium checks
        run: node scripts/check-openai-consumer.mjs
      - name: Retire exact temporary controls
        if: always()
        env:
          GITHUB_TOKEN: ${{ github.token }}
        run: node scripts/retire-openai-ci.mjs
